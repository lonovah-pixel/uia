# Скопируйте в .env и заполните нужное. Без ключей приложение работает на оценках по тарифам.

# Порт и адрес сервера
PORT=3000
HOST=0.0.0.0

# Реальные цены Яндекс Go — партнёрское API «Информация о поездке» (taxi_info).
# Ключи выдаются после подключения к партнёрской программе Яндекс Go.
YANDEX_TAXI_CLID=
YANDEX_TAXI_APIKEY=

# Реальные цены Uber — Riders API (OAuth-токен с доступом к estimates).
UBER_ACCESS_TOKEN=

# Построение маршрута. Публичный сервер OSRM — только для демонстрации,
# для продакшена поднимите свой (https://github.com/Project-OSRM/osrm-backend).
# Пустое значение — расстояние оценивается по прямой.
OSRM_URL=https://router.project-osrm.org

# Поиск адресов (Photon на данных OpenStreetMap). Для нагрузки — свой экземпляр.
PHOTON_URL=https://photon.komoot.io

# Таймаут запросов к внешним API, мс
HTTP_TIMEOUT_MS=4000

# Подпись запросов к открытым сервисам (требование их правил использования)
# USER_AGENT=my-taxi-app/1.0 (+https://example.com)

# Папка со сборкой фронтенда (по умолчанию apps/web/dist)
# STATIC_DIR=
